{
  "version": 2,
  "builds": [
    {
      "src": "api/generate.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": "index.html"
      }
    }
  ],
  "routes": [
    { "src": "/api/generate", "dest": "/api/generate" },
    { "src": "/?", "dest": "/api/generate" },
    { "src": "/(.*)", "dest": "/api/generate" }
  ]
}

{
  "manifest_version": 3,
  "name": "Solana Reply Generator",
  "version": "0.1.0",
  "description": "Create Solana Reply Generator replies from the Chrome right-click menu.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["contextMenus", "tabs"],
  "host_permissions": ["https://solanareplygenerator.lol/*"],
  "background": {
    "service_worker": "service_worker.js"
  }
}
